<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Staff sign in | BsmartQ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="auth-page">
    <main class="auth-shell">
      <div class="auth-brand">
        <img class="brand-logo" src="/images/file_00000000c0ec81f48652b42d6ca52a4d.png" alt="BsmartQ">
      </div>
      <section class="auth-card">
        <p class="eyebrow">STAFF PORTAL</p>
        <h1>Welcome back.</h1>
        <p class="auth-copy">
          Sign in to manage your organization's queues and customer flow.
        </p>
        <% if (error) { %>
        <div class="form-error"><%= error %></div>
        <% } %>
        <% if (message) { %>
        <div class="form-success"><%= message %></div>
        <% } %>
        <form method="post" action="/login">
          <input type="hidden" name="next" value="<%= next %>" /><label
            >Work email<input
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@organization.com"
              required /></label
          ><label
            >Password<input
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="Enter your password"
              required /></label
          ><button class="button primary full" type="submit">
            Sign in to dashboard
          </button>
        </form>
        <p class="auth-footer">
          Setting up a new organization?
          <a href="/register">Register your organization</a>
        </p>
      </section>
    </main>
  </body>
</html>
